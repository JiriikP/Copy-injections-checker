{
  "manifest_version": 3,
  "name": "Copy Injection Checker",
  "version": "2.3",
  "description": "Detekuje, zvýrazňuje nebo rovnou odstraňuje skrytý text.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "browser_specific_settings": {
    "gecko": {
      "id": "copy-injection-checker@jiriikp.github.io",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "140.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nastavení detektoru",
    "default_icon": "icon.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}